---
// Mail-app contact form (the website-contact-form skill). The visitor fills in the
// fields and presses the button; their own email program opens with a message to the
// owner, ready to send. The site sends nothing and stores nothing. The work is done by
// public/js/mail-form.js, a file of the site's own rather than an inline script, so a
// strict Content-Security-Policy (script-src 'self') lets it run.
//
//   <MailForm to="hello@your-domain.example" subject="Project enquiry" greeting="Dear Ms Smith," />
//
// `to`:      the address the messages go to. Never in the HTML as plain text: it is
//            encoded as EmailLink encodes it and decoded in the visitor's browser.
//            Also shown under the form, through EmailLink. Required.
// `subject`: the mail's subject line, chosen for this site: what the visitor comes for,
//            in their words ("Project enquiry", "Anfrage Bauvorhaben"). Also the
//            subject of the plain address under the form. Required.
// `greeting`: the mail's first line, as the owner wants it, punctuation included
//            ("Sehr geehrte Frau Wunder,", "Hallo Michaela,"). The mail ends with the
//            language's sign-off (`signoff` in mail-form-text.ts). Required.
// `lang`:    overrides the language. Default: the page's own, which Base.astro hands
//            down (a page built with <Base lang="de"> gets a German form by itself),
//            else the page's locale on a site with several languages.
//
// Fields of the page's own go between the tags, before the message; each reaches the mail
// as "Label: value", a ticked radio button as its label. A hint for the message goes in
// slot "hint": shown above the box and made its accessible description (the skill, "Adding fields").
//
// Without JavaScript the form stays hidden, since it could do nothing, and the line
// under it with the address is what a visitor sees. Once per page: its ids are fixed.
import EmailLink from './EmailLink.astro';
import { encodeEmail } from '../lib/obfuscate';
import { LIMITS, TEXT, hasText } from './mail-form-text';

interface Props { to: string; subject: string; greeting: string; lang?: string }
const { to, subject, greeting } = Astro.props;
if (!to) {
  throw new Error('MailForm: pass to="…", the address the messages go to (the website-contact-form skill, §2).');
}
if (!subject) {
  throw new Error('MailForm: pass subject="…", the subject line of the visitor\'s mail: what they come for, in their words, e.g. "Project enquiry" (the website-contact-form skill, §2 step 2).');
}
if (!greeting?.trim()) {
  throw new Error('MailForm: pass greeting="…", the first line of the visitor\'s mail, e.g. "Sehr geehrte Frau Wunder," (the website-contact-form skill, §2 step 2).');
}
const pageLang = Astro.props.lang ?? Astro.locals.lang ?? Astro.currentLocale;
if (!pageLang) {
  throw new Error('MailForm: no language for this page. Add `Astro.locals.lang = lang;` after the props in src/layouts/Base.astro, as the starter has it, or pass lang="…" (the website-contact-form skill, §2 step 3).');
}
const language = pageLang.toLowerCase().split('-')[0];
// A language with no texts stops the build: an English form on a page in another
// language would otherwise go out unnoticed.
if (!hasText(language)) {
  throw new Error(`MailForm: no texts for the language "${language}". Add it to src/components/mail-form-text.ts (the website-contact-form skill, "Add a language").`);
}
const t = TEXT[language];
const hasHint = Astro.slots.has('hint');
---
<form id="mail-form" class="mail-form" lang={language} data-mail-form data-to={encodeEmail(to)} data-subject={subject} data-greeting={greeting.trim()} data-signoff={t.signoff} hidden>
  <slot />
  <p>
    <label for="mail-form-message">{t.message}</label>
    {hasHint && <span class="mail-form-hint" id="mail-form-hint"><slot name="hint" /></span>}
    <textarea id="mail-form-message" name="message" rows="6" required maxlength={LIMITS.message} aria-describedby={hasHint ? 'mail-form-hint' : undefined}></textarea>
  </p>
  <p class="mail-form-note">{t.note}</p>
  <p><button type="submit">{t.send}</button></p>
  {/* The line a screen reader is told to read out once the button was pressed. */}
  <p class="mail-form-status" role="status" aria-live="polite" data-mail-form-status data-opened={t.opened}></p>
</form>
{/* Outside the form and never hidden: a visitor without JavaScript, or without a mail
     program set up, still finds the address here. */}
<p class="mail-form-direct" lang={language}>{t.direct} <EmailLink address={to} subject={subject} lang={language} /></p>
<script is:inline src="/js/mail-form.js" defer></script>

<style>
  /* Fields a page puts in the slot carry the page's style scope, not this one: the
     :global rules below reach them, inside this form only. */
  .mail-form label { display: block; margin-bottom: 0.25rem; }
  .mail-form :global(label), .mail-form :global(legend) { font-weight: 600; }
  .mail-form :global(input:not([type='checkbox']):not([type='radio'])), .mail-form :global(select), .mail-form textarea {
    display: block; width: 100%; max-width: 36rem; margin-top: 0.25rem; padding: 0.5rem; font: inherit; color: var(--ink);
    background: var(--surface); border: 1px solid var(--muted); border-radius: 6px;
  }
  .mail-form :global(fieldset) { border: 0; padding: 0; margin: 0 0 1rem; }
  .mail-form :global(legend) { padding: 0; margin-bottom: 0.35rem; }
  .mail-form :global(fieldset label) { display: block; font-weight: 400; margin: 0.25rem 0; }
  .mail-form :global(.mail-form-optional) { color: var(--muted); font-weight: 400; }
  .mail-form-hint { display: block; color: var(--muted); margin-bottom: 0.35rem; max-width: 36rem; }
  .mail-form button { font: inherit; padding: 0.6rem 1.2rem; border-radius: 6px; border: 1px solid var(--ink); background: var(--ink); color: var(--bg); cursor: pointer; }
  .mail-form-note { color: var(--muted); max-width: 36rem; }
</style>
