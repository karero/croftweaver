{
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npx astro:*)",
      "Bash(npx keystatic:*)",
      "Bash(npx playwright:*)",
      "Bash(npx wrangler pages dev:*)",
      "Bash(npx wrangler whoami:*)",
      "Bash(wrangler pages dev:*)",
      "Bash(wrangler whoami:*)",
      "Bash(astro:*)",
      "Bash(playwright:*)",
      "Bash(bash scripts/check_external_links.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git checkout -b production)",
      "Bash(git checkout main)",
      "Bash(git checkout -- .gitignore)",
      "Bash(git switch main)",
      "Bash(git switch -)",
      "Bash(git init)",
      "Bash(git fetch)",
      "Bash(git fetch origin)",
      "Bash(git pull)",
      "Bash(git pull --ff-only)",
      "Bash(git pull --no-rebase)",
      "Bash(git push)",
      "Bash(git push -u origin main)",
      "Bash(git push -u origin production)",
      "Bash(git push --dry-run origin HEAD:main)",
      "Bash(git rev-parse:*)",
      "Bash(node --version)",
      "Bash(gh auth status:*)",
      "Bash(gh repo view:*)",
      "Bash(gh repo create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(touch:*)",
      "Bash(echo:*)",
      "WebFetch(domain:docs.astro.build)",
      "WebFetch(domain:developers.cloudflare.com)",
      "WebFetch(domain:keystatic.com)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git reset --hard:*)",
      "Bash(gh repo delete:*)",
      "Bash(npx wrangler pages delete:*)",
      "Bash(npx wrangler delete:*)",
      "Bash(wrangler pages delete:*)",
      "Bash(wrangler delete:*)",
      "Bash(git * --output*)",
      "Bash(git add --pathspec*)",
      "Bash(git add * --pathspec*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-stand.mjs\" start",
            "timeout": 60,
            "statusMessage": "Syncing with GitHub…"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-stand.mjs\" prompt",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
