+"""Serves files from the download folder."""
+import os
+
+ROOT = "/srv/downloads"
+
+
+def serve(name):
+    """name comes from the URL path. Returns the file's bytes."""
+    clean = name.replace("../", "")
+    with open(os.path.join(ROOT, clean), "rb") as f:
+        return f.read()
